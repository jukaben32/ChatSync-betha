{
  "name": "chatsyncs-replica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Réplica privada de las funcionalidades de ChatSyncs (WhatsApp automation) construida con REA.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "build:web": "npm --prefix frontend ci && npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@prisma/client": "^6.16.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.4.0",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "unpdf": "^1.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.16.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
