generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id             String   @id @default(uuid()) @db.Uuid
  phone          String   @db.VarChar(32)
  name           String?  @db.VarChar(255)
  email          String?  @db.VarChar(320)
  customFields   Json     @default("{}")
  labels         SubscriberLabel[]
  conversations Conversation[]
  notes          SubscriberNote[]
  sequences     SubscriberSequence[]
  orders         Order[]
  deals          CrmDeal[]
  broadcastRecipients BroadcastRecipient[]
  jobs           ScheduledJob[]
  flowSessions   FlowSession[]
  lists          AudienceListMember[]
  formSubmissions FormSubmission[]
  appointments   Appointment[]
  blocked        Boolean  @default(false)
  optedOut       Boolean  @default(false)
  source         String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  @@unique([phone])
  @@index([phone])
}

model Label {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @unique @db.VarChar(255)
  subscribers SubscriberLabel[]
  createdAt   DateTime           @default(now()) @db.Timestamptz
}

model SubscriberLabel {
  subscriberId String    @db.Uuid
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  labelId      String    @db.Uuid
  label        Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)
  assignedAt  DateTime @default(now()) @db.Timestamptz

  @@id([subscriberId, labelId])
}

model Conversation {
  id             String        @id @default(uuid()) @db.Uuid
  subscriberId  String        @db.Uuid
  subscriber    Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  status        String        @default("open") @db.VarChar(32)
  assignedTo    String?       @db.VarChar(64)
  followUpAt    DateTime?     @db.Timestamptz
  unread        Boolean       @default(false)
  nudges        Int           @default(0)
  important     Boolean       @default(false)
  channel       String        @default("whatsapp") @db.VarChar(32)
  messages      Message[]
  notes         SubscriberNote[]
  createdAt     DateTime      @default(now()) @db.Timestamptz
  updatedAt     DateTime      @updatedAt @db.Timestamptz

  @@index([subscriberId, status, updatedAt])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction     String        @db.VarChar(16) // inbound | outbound
  channel       String        @default("whatsapp") @db.VarChar(32)
  providerMessageId String?  @db.VarChar(128)
  body          String        @default("") @db.Text
  mediaUrl      String?       @db.VarChar(512)
  status        String        @default("delivered") @db.VarChar(32)
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now()) @db.Timestamptz

  @@index([conversationId, createdAt])
}

model SubscriberNote {
  id            String      @id @default(uuid()) @db.Uuid
  subscriberId String      @db.Uuid
  subscriber    Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  conversationId String?   @db.Uuid
  conversation  Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  author        String      @db.VarChar(64)
  body          String      @db.Text
  createdAt     DateTime    @default(now()) @db.Timestamptz
}

model Sequence {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @db.VarChar(255)
  kind        String              @default("sequence") @db.VarChar(16) // sequence | flow
  triggerKeyword String?          @db.VarChar(128)
  active      Boolean             @default(true)
  jobs        ScheduledJob[]
  flowSessions FlowSession[]
  stopOnReply Boolean            @default(true)
  folder      String?            @db.VarChar(64)
  matchType   String             @default("contains") @db.VarChar(16) // contains | exact | starts
  triggerLabel String?           @db.VarChar(128)
  steps      SequenceStep[]
  enrollments SubscriberSequence[]
  createdAt   DateTime            @default(now()) @db.Timestamptz
}

model SequenceStep {
  id          String       @id @default(uuid()) @db.Uuid
  sequenceId String       @db.Uuid
  sequence    Sequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  delayDays   Int          @default(0)
  action     String       @db.VarChar(64) // send_text | send_template | wait | condition
  params      Json         @default("{}")
  order       Int
}

model SubscriberSequence {
  subscriberId String   @db.Uuid
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  sequenceId   String   @db.Uuid
  sequence     Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime @default(now()) @db.Timestamptz
  status       String   @default("active") @db.VarChar(16) // active | stopped | completed
  @@id([subscriberId, sequenceId])
}

model Broadcast {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(255)
  audience    Json          @default("{}") // segment filters
  contentType String       @db.VarChar(32) // text | template
  content    String        @db.Text
  status      String        @default("draft") @db.VarChar(32)
  sentCount   Int           @default(0)
  deliveredCount Int       @default(0)
  readCount   Int           @default(0)
  failedCount Int           @default(0)
  language    String        @default("es") @db.VarChar(16)
  scheduledAt DateTime?     @db.Timestamptz
  recipients  BroadcastRecipient[]
  mediaUrl    String?       @db.VarChar(1024)
  buttons     Json          @default("[]")
  clickedCount Int          @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz
  updatedAt   DateTime      @updatedAt @db.Timestamptz
}

model Order {
  id          String       @id @default(uuid()) @db.Uuid
  subscriberId String    @db.Uuid
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  number       String?     @db.VarChar(64)
  status       String      @default("pending") @db.VarChar(32)
  amount       Int          @default(0)
  currency     String      @default("INR") @db.Char(3)
  metadata     Json        @default("{}")
  createdAt    DateTime    @default(now()) @db.Timestamptz
  updatedAt    DateTime    @updatedAt @db.Timestamptz
}

model CrmDeal {
  id          String       @id @default(uuid()) @db.Uuid
  subscriberId String     @db.Uuid
  subscriber   Subscriber  @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  stage       String       @default("new") @db.VarChar(64)
  value       Int          @default(0)
  owner       String?      @db.VarChar(64)
  metadata    Json        @default("{}")
  createdAt   DateTime    @default(now()) @db.Timestamptz
  updatedAt   DateTime    @updatedAt @db.Timestamptz
}

model BroadcastRecipient {
  id                String     @id @default(uuid()) @db.Uuid
  broadcastId       String     @db.Uuid
  broadcast         Broadcast  @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  subscriberId      String     @db.Uuid
  subscriber        Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  providerMessageId String?    @db.VarChar(128)
  status            String     @default("queued") @db.VarChar(32) // queued | sent | delivered | read | failed
  error             String?    @db.Text
  clickedAt         DateTime?  @db.Timestamptz
  clickedButton     String?    @db.VarChar(64)
  createdAt         DateTime   @default(now()) @db.Timestamptz

  @@index([broadcastId, status])
  @@index([providerMessageId])
}

model Template {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  language  String   @default("es") @db.VarChar(16)
  category  String   @default("MARKETING") @db.VarChar(32)
  body      String   @db.Text
  status    String   @default("draft") @db.VarChar(32) // draft | pending | approved | rejected
  metaId    String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@unique([name, language])
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(320)
  role      String   @default("agent") @db.VarChar(32) // admin | agent
  passwordHash String? @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
}

model KnowledgeSource {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(16) // text | url | file | sheet
  title     String   @db.VarChar(255)
  sourceUrl String?  @db.VarChar(1024)
  content   String   @db.Text
  chunks    KnowledgeChunk[]
  createdAt DateTime @default(now()) @db.Timestamptz
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  url       String   @db.VarChar(1024)
  events    String[]
  secret    String?  @db.VarChar(128)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(255)
  prefix     String    @db.VarChar(16)
  hash       String    @unique @db.VarChar(64)
  lastUsedAt DateTime? @db.Timestamptz
  scopes     String[]
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz
}

model ScheduledJob {
  id           String     @id @default(uuid()) @db.Uuid
  subscriberId String     @db.Uuid
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  sequenceId   String     @db.Uuid
  sequence     Sequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  resumeOrder  Int        // next step order to run
  runAt        DateTime   @db.Timestamptz
  status       String     @default("pending") @db.VarChar(16) // pending | done | failed
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@index([status, runAt])
}

model CustomFieldDef {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(64)
  label     String   @db.VarChar(255)
  type      String   @default("text") @db.VarChar(16) // text | number | date | boolean
  createdAt DateTime @default(now()) @db.Timestamptz
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz
}

model CannedResponse {
  id        String   @id @default(uuid()) @db.Uuid
  shortcut  String   @unique @db.VarChar(64)
  title     String   @db.VarChar(255)
  body      String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
}

model FlowSession {
  id            String     @id @default(uuid()) @db.Uuid
  subscriberId  String     @db.Uuid
  subscriber    Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  sequenceId    String     @db.Uuid
  sequence      Sequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  awaitingOrder Int        // paso que está esperando la respuesta del cliente
  status        String     @default("active") @db.VarChar(16) // active | done | expired
  createdAt     DateTime   @default(now()) @db.Timestamptz
  updatedAt     DateTime   @updatedAt @db.Timestamptz

  @@index([subscriberId, status])
}

model InboundWorkflow {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(255)
  token        String   @unique @db.VarChar(64)
  phonePath    String   @default("phone") @db.VarChar(128)
  templateName String?  @db.VarChar(255)
  language     String   @default("es") @db.VarChar(16)
  text         String?  @db.Text
  variables    Json     @default("{}") // { "1": "customer.name" }
  conditions   Json     @default("[]") // [{ path, op, value }]
  delayMinutes Int      @default(0)
  actions      Json     @default("{}") // { labels: [], sequenceId, assignTo }
  active       Boolean  @default(true)
  lastPayload  Json?
  createdAt    DateTime @default(now()) @db.Timestamptz
}

model ApiLog {
  id        String   @id @default(uuid()) @db.Uuid
  keyName   String?  @db.VarChar(64)
  method    String   @db.VarChar(8)
  path      String   @db.VarChar(255)
  status    Int
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}

model AudienceList {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @unique @db.VarChar(255)
  members   AudienceListMember[]
  createdAt DateTime             @default(now()) @db.Timestamptz
}

model AudienceListMember {
  listId       String       @db.Uuid
  list         AudienceList @relation(fields: [listId], references: [id], onDelete: Cascade)
  subscriberId String       @db.Uuid
  subscriber   Subscriber   @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  addedAt      DateTime     @default(now()) @db.Timestamptz

  @@id([listId, subscriberId])
  @@index([subscriberId])
}

model KnowledgeChunk {
  id         String          @id @default(uuid()) @db.Uuid
  sourceId   String          @db.Uuid
  source     KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  position   Int
  text       String          @db.Text

  @@index([sourceId])
}

model Form {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(255)
  keyword     String?          @db.VarChar(128)
  intro       String?          @db.Text
  doneMessage String           @default("¡Gracias! Hemos recibido tus respuestas.") @db.Text
  questions   Json             @default("[]") // [{ key, label, type: text|number|email|phone|date|choice, options?: string[], required }]
  labelOnDone String?          @db.VarChar(128)
  active      Boolean          @default(true)
  sequenceId  String?          @db.Uuid // flujo compilado a partir del formulario
  submissions FormSubmission[]
  createdAt   DateTime         @default(now()) @db.Timestamptz
}

model FormSubmission {
  id           String     @id @default(uuid()) @db.Uuid
  formId       String     @db.Uuid
  form         Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  subscriberId String     @db.Uuid
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  answers      Json
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@index([formId, createdAt])
}

model Appointment {
  id           String     @id @default(uuid()) @db.Uuid
  subscriberId String     @db.Uuid
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  startsAt     DateTime   @db.Timestamptz
  endsAt       DateTime   @db.Timestamptz
  status       String     @default("booked") @db.VarChar(16) // booked | cancelled | completed | no_show
  title        String?    @db.VarChar(255)
  notes        String?    @db.Text
  createdAt    DateTime   @default(now()) @db.Timestamptz

  @@index([startsAt])
  @@index([subscriberId])
}

model LoginLog {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String   @db.VarChar(255)
  role      String   @db.VarChar(16)
  ip        String?  @db.VarChar(64)
  ok        Boolean
  createdAt DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}
